<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />

    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="true"
        android:version="1" />
    <uses-feature
        android:name="android.software.xr.api.openxr"
        android:required="true" />
    <!-- Required for XR_FB_passthrough: without this flag the OS keeps the app
         passthrough-disabled and xrCreatePassthroughFB/passthrough layers do nothing. -->
    <uses-feature
        android:name="com.oculus.feature.PASSTHROUGH"
        android:required="false" />

    <application>
        <uses-native-library
            android:name="libopenxr.google.so"
            android:required="false" />
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="${questSupportedDevices}" />
        <meta-data
            android:name="com.oculus.vr.focusaware"
            android:value="true" />
        <!-- StreetMR r25: GPU one level up, CPU one down (was -1). Street's slow views are
             GPU-bound (MR holds the GPU at level 1) while the busiest CPU core is ~35%.
             r30: 0, between the two. At -1 MR ran CPU 3 / GPU 1 (350 MHz, GPU-bound, 51 fps);
             at 1 MR ran CPU 2 (1382 MHz) / GPU 3, and worn the game fell to 73-88% speed at
             match start (Lance r28: "MR laggy"). VR held 100% at CPU 3.
             r35l (2026-10-15, public app, unworn A/B in a match): at 0 MR sits at GPU level 2
             (456 MHz) 85-97% busy, 56-59 fps / 95-97% speed, while the busiest CPU core averages
             53% (max 72%). Back to 1 now that the CPU side is lighter (Jumbotron only, no HD
             texture pack lookups). Measured again before it ships.
             r35m: back to 0. At 1 the measured MR gain was nothing (59.2 -> 59.0 fps, GPU 456 ->
             492 MHz), and a lower CPU clock hurts an emulator in short bursts (GPT review). -->
        <meta-data
            android:name="com.oculus.trade_cpu_for_gpu_amount"
            android:value="0" />

        <activity
            android:name=".activities.EmulationActivity"
            android:theme="@style/Theme.Dolphin.EmulationVR"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:exported="true"
            tools:node="merge"
            tools:replace="android:theme,android:exported">
            <property
                android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
                android:value="XR_ACTIVITY_START_MODE_FULL_SPACE_UNMANAGED" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".activities.OpenXRControllerMapperActivity"
            android:theme="@style/Theme.Dolphin.EmulationVR"
            android:taskAffinity="${applicationId}.openxr_mapper"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:exported="true">
            <property
                android:name="android.window.PROPERTY_XR_ACTIVITY_START_MODE"
                android:value="XR_ACTIVITY_START_MODE_FULL_SPACE_UNMANAGED" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>

</manifest>
